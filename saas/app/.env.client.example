# Public website measurement identifiers, embedded by Vite at build time.
# Supply these explicitly in the environment of the Vite build command.
# Wasp does not load VITE_* from .env.client; copying this file does not enable them.
# An empty identifier disables that provider. Never put API secrets here.
# These IDs do not enable tracking until a visitor explicitly accepts statistics.
VITE_GA4_MEASUREMENT_ID=G-XPSC1KS613
VITE_CLARITY_PROJECT_ID=ytw1viphzw
