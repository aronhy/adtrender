[Unit]
Description=Google and YouTube public advertising advertising collector
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/google-collector-runtime.env
ExecStartPre=-/usr/bin/docker rm -f google-collector
ExecStart=/opt/google-collector/run.sh
ExecStop=/usr/bin/docker stop --time 240 google-collector
Restart=always
RestartSec=60
TimeoutStopSec=260
UMask=0077

[Install]
WantedBy=multi-user.target
