[Unit]
Description=Ad Research API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adresearch
Group=adresearch
WorkingDirectory=/srv/ad-research/current/app
EnvironmentFile=/etc/ad-research/server.env
Environment=NODE_ENV=production
ExecStart=/opt/ad-research/node-v24.14.1/bin/node --enable-source-maps .wasp/out/server/bundle/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=ad-research
CacheDirectory=ad-research
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
