[Unit]
Description=TikTok public commercial library collector
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/tiktok-collector-runtime.env
ExecStartPre=-/usr/bin/docker rm -f tiktok-collector
ExecStart=/opt/tiktok-collector/run.sh
ExecStop=/usr/bin/docker stop --time 300 tiktok-collector
Restart=always
RestartSec=60
TimeoutStopSec=320
UMask=0077

[Install]
WantedBy=multi-user.target
