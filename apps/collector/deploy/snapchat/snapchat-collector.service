[Unit]
Description=Snapchat public ads gallery collector
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/snapchat-collector-runtime.env
ExecStartPre=-/usr/bin/docker rm -f snapchat-collector
ExecStart=/opt/snapchat-collector/run.sh
ExecStop=/usr/bin/docker stop --time 240 snapchat-collector
Restart=always
RestartSec=60
TimeoutStopSec=260
UMask=0077

[Install]
WantedBy=multi-user.target
