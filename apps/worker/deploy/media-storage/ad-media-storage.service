[Unit]
Description=AdThrender public advertising media archival
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
EnvironmentFile=/etc/ad-media-storage-runtime.env
ExecStartPre=-/usr/bin/docker rm -f ad-media-storage
ExecStart=/opt/ad-media-storage/run.sh
ExecStop=/usr/bin/docker stop --time 150 ad-media-storage
Restart=always
RestartSec=30
TimeoutStopSec=180
UMask=0077
[Install]
WantedBy=multi-user.target
