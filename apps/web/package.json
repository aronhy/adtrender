{
  "name": "ad-research-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "dev": "../../scripts/wasp.sh start",
    "build": "../../scripts/wasp.sh build",
    "build:api": "node ../../scripts/build-api.mjs",
    "compile": "../../scripts/wasp.sh compile",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ad-research/contracts": "file:../../packages/contracts",
    "@aws-sdk/client-s3": "3.1000.0",
    "@aws-sdk/s3-request-presigner": "3.1000.0",
    "@prisma/client": "5.19.1",
    "@radix-ui/react-slot": "1.2.4",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "morgan": "1.12.1",
    "nodemailer": "10.0.13",
    "openai": "6.27.0",
    "playwright": "1.62.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1",
    "recharts": "3.10.1",
    "stripe": "18.1.0",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@types/big.js": "7.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "7.0.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec",
    "esbuild": "0.28.2",
    "prisma": "5.19.1",
    "tailwindcss": "4.3.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "morgan": "1.12.1",
    "nodemon": "3.1.14"
  },
  "wasp": {
    "overriddenDeps": {
      "morgan": "~1.10.0"
    }
  }
}
