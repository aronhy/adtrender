# Local only. Never reuse existing DS services or production credentials.
DATABASE_URL=postgresql://saas_local@127.0.0.1:55438/saas_dev
PORT=3001
WASP_WEB_CLIENT_URL=http://localhost:3000
WASP_SERVER_URL=http://localhost:3001
REGISTRATION_MODE=invite
REGISTRATION_ALLOWLIST=
# Wasp requires these keys even while Google is disabled; keep blank assignments.
# Enable only with a dedicated Google OAuth Web client. Never reuse Ads OAuth.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Direct local API uses its socket IP. Behind a reverse proxy, allow only its
# exact socket IP and configure the proxy to overwrite X-Real-IP; never trust XFF.
TRUSTED_PROXY_IPS=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=local
SMTP_PASSWORD=local
EMAIL_FROM=research@example.com
BILLING_ENABLED=false
LIVE_BILLING_ENABLED=false
# Development fixtures only, not approved production terms.
# Production startup requires all five values to be explicitly supplied.
TRIAL_DAYS=14
TRIAL_WORKSPACES=1
TRIAL_MEMBERS=3
TRIAL_SAVED_ADS=100
TRIAL_ANALYSES=20
# Provider credentials stay server-side; configure verified services before acceptance.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OUTBOX_ENCRYPTION_KEY=64_hex_characters
# OPENAI_API_KEY=
# ANALYSIS_MODEL=
