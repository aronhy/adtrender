# One root-owned 0600 file shared by API and worker. No real credentials here.
NODE_ENV=production
PORT=3001
DATABASE_URL=
WASP_WEB_CLIENT_URL=https://research.example.com
WASP_SERVER_URL=https://api.research.example.com
JWT_SECRET=
REGISTRATION_MODE=invite
REGISTRATION_ALLOWLIST=
GOOGLE_AUTH_ENABLED=false
# Required keys even when disabled; use a dedicated OAuth Web client to enable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTBOX_ENCRYPTION_KEY=
RATE_LIMIT_HMAC_SECRET=
# Exact API socket peer IPs only, comma-separated; never CIDRs, hostnames or '*'.
# Set after reading the real Docker gateway/proxy IP. Nginx must overwrite
# X-Real-IP with $remote_addr. Unset/untrusted/invalid values use the socket IP;
# X-Forwarded-For is ignored. Keep the API host port bound to loopback.
TRUSTED_PROXY_IPS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
ANALYSIS_MODEL=
META_BROWSER_CHANNEL=chromium
BILLING_ENABLED=false
LIVE_BILLING_ENABLED=false
# Publish only explicitly confirmed LIVE plan versions. Separate from sandbox billing.
PUBLIC_PRICING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Confirm business policy before setting one of the supported refund policies.
STRIPE_REFUND_POLICY=
# Required explicit business terms. Do not copy development defaults as approved offers.
# Days: 1..90; each quota: positive integer <= 2147483647.
TRIAL_DAYS=
TRIAL_WORKSPACES=
TRIAL_MEMBERS=
TRIAL_SAVED_ADS=
TRIAL_ANALYSES=
