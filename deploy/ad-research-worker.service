[Unit]
Description=Ad Research independent worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adresearch
Group=adresearch
WorkingDirectory=/srv/ad-research/current/apps/web
EnvironmentFile=/etc/ad-research/server.env
Environment=NODE_ENV=production
Environment=HOME=/var/lib/ad-research
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/ad-research/playwright
ExecStart=/opt/ad-research/node-v24.14.1/bin/node --enable-source-maps dist-worker/index.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=ad-research
CacheDirectory=ad-research
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
