# Independent configuration. Do not reuse app.env or include provider/application credentials.
# Leave disabled until an HTTPS receiver and its header token have been supplied and tested.
MONITOR_ENABLED=false
MONITOR_SERVICE_ID=ad-research-test
MONITOR_HEALTH_URL=http://127.0.0.1:13001/health
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TOKEN=
MONITOR_STATE_DIR=/state
MONITOR_TIMEOUT_MS=5000
